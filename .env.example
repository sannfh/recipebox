APP_SECRET_KEY=your-secret-key-here
APP_DEBUG=false
APP_DATABASE_URL=postgresql+asyncpg://recipebox_user:yourpassword@localhost:5432/recipebox

# Embeddings (OpenAI text-embedding-3-small by default)
APP_OPENAI_API_KEY=sk-...
APP_EMBEDDING_MODEL=text-embedding-3-small

# Claude agent
APP_ANTHROPIC_API_KEY=sk-ant-...
APP_ANTHROPIC_MODEL=claude-sonnet-4-6
APP_AGENT_RATE_LIMIT_PER_MINUTE=30

# Redis (cache + rate limiter); empty = run without Redis
APP_REDIS_URL=redis://localhost:6379/0

# Docker only — Compose reads this to set the Postgres container password
DB_PASSWORD=yourpassword
